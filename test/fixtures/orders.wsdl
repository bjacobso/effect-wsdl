  <wsdl:portType name="OrdersPortType"><wsdl:operation name="GetOrder"><wsdl:input message="tns:GetOrderInput"/><wsdl:output message="tns:GetOrderOutput"/><wsdl:fault name="OrderNotFound" message="tns:OrderNotFoundMessage"/></wsdl:operation></wsdl:portType>
  <wsdl:binding name="OrdersSoapBinding" type="tns:OrdersPortType">
